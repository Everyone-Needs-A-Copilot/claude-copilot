      "TypeScript + shell test suite",
      "cc eval (local runner, no LLM calls)",
      "check-test-wiring",
      "check-hardcoded-paths",
      "cc Onboard Contract gate",
      "Time Estimate Language gate"
    ],
    "cli-copilot": ["lint-and-test (3.11)", "lint-and-test (3.12)"],
    "cli-copilot-internal": ["lint-and-test (3.11)", "lint-and-test (3.12)"],
    "copilot-control-tower": ["shipping-swift-fitness"]
