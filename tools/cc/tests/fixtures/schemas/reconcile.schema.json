{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everyoneneedsacopilot.com/schemas/claude-copilot/reconcile.schema.json",
  "title": "cc reconcile report",
  "oneOf": [
    { "$ref": "#/$defs/assessReport" },
    { "$ref": "#/$defs/assistantPrepareReport" },
    { "$ref": "#/$defs/assistantRunReport" },
    { "$ref": "#/$defs/assistantStatusReport" },
    { "$ref": "#/$defs/planReport" },
    { "$ref": "#/$defs/applyReport" },
    { "$ref": "#/$defs/recoverReport" },
    { "$ref": "#/$defs/verifyReport" },
    { "$ref": "#/$defs/errorReport" }
  ],
  "$defs": {
    "opaqueRunId": { "type": "string", "pattern": "^run_[0-9a-f]{32}$" },
    "opaquePlanId": { "type": "string", "pattern": "^plan_[0-9a-f]{32}$" },
    "opaqueSessionId": { "type": "string", "pattern": "^session_[0-9a-f]{32}$" },
    "opaqueProposalId": { "type": "string", "pattern": "^proposal_[0-9a-f]{32}$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "detail"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "responsible_actor", "evidence", "next_action"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "responsible_actor": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "next_action": { "type": "string", "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component", "state", "selected", "recommended",
        "recommendation_reason", "responsible_actor", "evidence",
        "missing_requirements", "next_action", "recipe_options"
      ],
      "properties": {
        "component": { "enum": ["claude", "codex"] },
        "state": {
          "enum": [
            "ready", "not-present", "not-selected", "safe-setup-available",
            "safe-update-available", "customized-guided-route", "held",
            "owner-decision", "could-not-verify", "excluded",
            "source-unavailable", "not-applicable"
          ]
        },
        "selected": { "type": "boolean" },
        "recommended": { "type": "boolean" },
        "recommendation_reason": { "type": "string", "minLength": 1 },
        "responsible_actor": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "missing_requirements": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "next_action": { "type": "string", "minLength": 1 },
        "recipe_options": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/recipeOption" }
        }
      }
    },
    "recipeOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe_id", "component", "summary"],
      "properties": {
        "recipe_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "component": { "enum": ["claude", "codex"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "defaultSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "components", "category"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["claude", "codex"] },
          "allOf": [
            {
              "if": { "minItems": 2 },
              "then": {
                "prefixItems": [
                  { "const": "claude" },
                  { "const": "codex" }
                ]
              }
            }
          ]
        },
        "category": { "enum": ["new-setup", "correction"] },
        "recipe_ids": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "enum": ["claude", "codex"] },
          "properties": {
            "claude": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
            "codex": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
          }
        }
      }
    },
    "batchSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_setup", "correction", "ready", "needs_review", "selected", "total",
        "product_projects", "managed_separately"
      ],
      "properties": {
        "new_setup": { "type": "integer", "minimum": 0 },
        "correction": { "type": "integer", "minimum": 0 },
        "ready": { "type": "integer", "minimum": 0 },
        "needs_review": { "type": "integer", "minimum": 0 },
        "selected": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "product_projects": { "type": "integer", "minimum": 0 },
        "managed_separately": { "type": "integer", "minimum": 0 }
      }
    },
    "leftUnchanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "held", "owner_decision", "could_not_verify", "excluded",
        "source_unavailable", "other"
      ],
      "properties": {
        "held": { "type": "integer", "minimum": 0 },
        "owner_decision": { "type": "integer", "minimum": 0 },
        "could_not_verify": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "source_unavailable": { "type": "integer", "minimum": 0 },
        "other": { "type": "integer", "minimum": 0 }
      }
    },
    "resolutionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic", "claude_assisted", "total_actionable",
        "managed_separately", "left_unchanged", "new_setup", "correction"
      ],
      "properties": {
        "automatic": { "type": "integer", "minimum": 0 },
        "claude_assisted": { "type": "integer", "minimum": 0 },
        "total_actionable": { "type": "integer", "minimum": 0 },
        "managed_separately": { "type": "integer", "minimum": 0 },
        "left_unchanged": { "$ref": "#/$defs/leftUnchanged" },
        "new_setup": { "type": "integer", "minimum": 0 },
        "correction": { "type": "integer", "minimum": 0 }
      }
    },
    "machineSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "title", "detail"],
      "properties": {
        "state": { "enum": ["ready", "action-required", "could-not-verify"] },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "assistantProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage", "liveness", "detail", "started_at", "last_activity_at",
        "elapsed_seconds", "selected_project_count", "candidate_group_count",
        "candidate_count"
      ],
      "properties": {
        "stage": {
          "enum": [
            "session-prepared", "claude-code-running",
            "python-validating-selections", "python-validating-plan",
            "ready", "blocked"
          ]
        },
        "liveness": { "enum": ["waiting", "active", "stale", "complete", "blocked"] },
        "detail": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "last_activity_at": { "type": "string", "format": "date-time" },
        "elapsed_seconds": { "type": "integer", "minimum": 0 },
        "selected_project_count": { "type": "integer", "minimum": 1 },
        "candidate_group_count": { "type": "integer", "minimum": 1 },
        "candidate_count": { "type": "integer", "minimum": 1 }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "state", "path", "version", "detail"],
      "properties": {
        "component": { "enum": ["claude", "codex"] },
        "state": { "type": "string", "minLength": 1 },
        "path": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "detail"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "dossier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspection_id", "current_evidence", "missing_requirements",
        "preservation", "allowed_targets", "prohibited_actions",
        "verification", "stop_conditions"
      ],
      "properties": {
        "inspection_id": { "$ref": "#/$defs/fingerprint" },
        "current_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "missing_requirements": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "preservation": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "allowed_targets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "prohibited_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "stop_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "repositoryScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "product-project" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "product", "role", "layer_id", "repository"],
          "properties": {
            "kind": { "const": "ecosystem-repository" },
            "product": { "enum": ["claude", "codex", "knowledge", "cli"] },
            "role": { "type": "string", "minLength": 1 },
            "layer_id": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "root", "name", "scope", "inspection_id", "presence", "route",
        "selected_components", "components", "blockers", "next_action"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/repositoryScope" },
        "inspection_id": { "$ref": "#/$defs/fingerprint" },
        "presence": { "enum": ["none", "claude-only", "codex-only", "both", "unknown"] },
        "route": {
          "enum": [
            "ready", "copilot-not-present", "safe-setup-available",
            "safe-update-available", "customized-guided-route", "held",
            "owner-decision", "could-not-verify", "excluded",
            "source-unavailable", "ecosystem-managed"
          ]
        },
        "selected_components": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["claude", "codex"] }
        },
        "components": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/component" },
                { "properties": { "component": { "const": "claude" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/component" },
                { "properties": { "component": { "const": "codex" } } }
              ]
            }
          ],
          "items": false
        },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
        "next_action": { "type": "string", "minLength": 1 },
        "dossier": { "$ref": "#/$defs/dossier" }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "helper", "frameworks", "configuration", "authentication",
        "connectivity", "layers", "dependencies", "blockers", "next_action"
      ],
      "properties": {
        "state": { "enum": ["ready", "action-required", "could-not-verify"] },
        "helper": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "version", "path", "detail"],
          "properties": {
            "state": { "type": "string", "minLength": 1 },
            "version": { "type": ["string", "null"] },
            "path": { "type": ["string", "null"] },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        "frameworks": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/framework" },
                { "properties": { "component": { "const": "claude" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/framework" },
                { "properties": { "component": { "const": "codex" } } }
              ]
            }
          ],
          "items": false
        },
        "configuration": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "path", "approved_roots", "detail"],
          "properties": {
            "state": { "type": "string", "minLength": 1 },
            "path": { "type": ["string", "null"] },
            "approved_roots": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        "authentication": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "credential_state", "detail"],
          "properties": {
            "state": { "type": "string", "minLength": 1 },
            "credential_state": { "type": "string", "minLength": 1 },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        "connectivity": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "detail"],
          "properties": {
            "state": { "type": "string", "minLength": 1 },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        "layers": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "ready", "total", "detail"],
          "properties": {
            "state": { "type": "string", "minLength": 1 },
            "ready": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "state", "detail"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
        "next_action": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_counts", "scope_counts", "selected_projects", "overlap_explanation"
      ],
      "properties": {
        "project_counts": {
          "type": "object", "additionalProperties": false,
          "required": [
            "ready", "copilot-not-present", "safe-setup-available",
            "safe-update-available", "customized-guided-route", "held",
            "owner-decision", "could-not-verify", "excluded",
            "source-unavailable", "ecosystem-managed", "total"
          ],
          "properties": {
            "ready": { "type": "integer", "minimum": 0 },
            "copilot-not-present": { "type": "integer", "minimum": 0 },
            "safe-setup-available": { "type": "integer", "minimum": 0 },
            "safe-update-available": { "type": "integer", "minimum": 0 },
            "customized-guided-route": { "type": "integer", "minimum": 0 },
            "held": { "type": "integer", "minimum": 0 },
            "owner-decision": { "type": "integer", "minimum": 0 },
            "could-not-verify": { "type": "integer", "minimum": 0 },
            "excluded": { "type": "integer", "minimum": 0 },
            "source-unavailable": { "type": "integer", "minimum": 0 },
            "ecosystem-managed": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "scope_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_repositories", "product_projects", "ecosystem_repositories"
          ],
          "properties": {
            "total_repositories": { "type": "integer", "minimum": 0 },
            "product_projects": { "type": "integer", "minimum": 0 },
            "ecosystem_repositories": { "type": "integer", "minimum": 0 }
          }
        },
        "selected_projects": { "type": "integer", "minimum": 0 },
        "overlap_explanation": { "type": "string", "minLength": 1 }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "kind", "component", "target", "description",
        "expected_before_fingerprint", "source_fingerprint"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^op_[0-9a-f]{64}$" },
        "kind": {
          "enum": [
            "create-file-from-source", "copy-file-from-source", "copy-tree-from-source",
            "append-managed-block", "merge-json-keys",
            "replace-recognized-symlink-with-copy", "create-internal-relative-symlink",
            "upsert-lock-component", "write-project-declaration",
            "associate-personal-project"
          ]
        },
        "component": { "enum": ["claude", "codex"] },
        "target": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "expected_before_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "source_fingerprint": {
          "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }]
        }
      }
    },
    "projectPlan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "path", "inspection_id", "recipes", "sources", "operations", "preservation",
        "prohibited_actions", "verification"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "inspection_id": { "$ref": "#/$defs/fingerprint" },
        "recipes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/recipeBinding" },
          "allOf": [
            {
              "if": { "minItems": 2 },
              "then": {
                "prefixItems": [
                  { "properties": { "component": { "const": "claude" } } },
                  { "properties": { "component": { "const": "codex" } } }
                ]
              }
            }
          ]
        },
        "sources": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceBinding" },
          "allOf": [
            {
              "if": { "minItems": 2 },
              "then": {
                "prefixItems": [
                  { "properties": { "component": { "const": "claude" } } },
                  { "properties": { "component": { "const": "codex" } } }
                ]
              }
            }
          ]
        },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
        "preservation": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "prohibited_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "verification": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "recipeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "recipe_id"],
      "properties": {
        "component": { "enum": ["claude", "codex"] },
        "recipe_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
      },
      "oneOf": [
        {
          "properties": {
            "component": { "const": "claude" },
            "recipe_id": { "type": "string", "pattern": "^claude[a-z0-9._-]{0,122}$" }
          }
        },
        {
          "properties": {
            "component": { "const": "codex" },
            "recipe_id": { "type": "string", "pattern": "^codex[a-z0-9._-]{0,123}$" }
          }
        }
      ]
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version", "fingerprint"],
      "properties": {
        "component": { "enum": ["claude", "codex"] },
        "version": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "rollbackTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "status", "detail"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "status": { "enum": ["restored", "mismatch", "conflict", "unreadable"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "ledgerEntry": {
      "type": "object", "additionalProperties": false,
      "required": [
        "path", "status", "detail", "completed_operation_ids", "verification", "rollback"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["applied", "blocked", "rolled-back", "incomplete-rollback", "unchanged"] },
        "detail": { "type": "string", "minLength": 1 },
        "completed_operation_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^op_[0-9a-f]{64}$" } },
        "verification": { "enum": ["ready", "failed", "not-run"] },
        "rollback": { "type": "array", "items": { "$ref": "#/$defs/rollbackTarget" } }
      }
    },
    "diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "state", "path", "created_at", "detail"],
      "properties": {
        "schema_version": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["available", "unavailable"] },
        "path": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "commonSuccess": {
      "type": "object",
      "required": [
        "schema_version", "phase", "result", "run_id", "generated_at",
        "machine", "projects", "summary", "next_actions"
      ],
      "properties": {
        "schema_version": { "const": "2.0" },
        "phase": { "enum": ["assess", "plan", "apply", "verify"] },
        "result": { "type": "string", "minLength": 1 },
        "run_id": { "$ref": "#/$defs/opaqueRunId" },
        "generated_at": { "type": "string", "format": "date-time" },
        "machine": { "$ref": "#/$defs/machine" },
        "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
        "summary": { "$ref": "#/$defs/summary" },
        "next_actions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "assessReport": {
      "allOf": [
        { "$ref": "#/$defs/commonSuccess" },
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "machine_summary", "default_selection", "batch_summary",
            "assistant_selection", "resolution_summary"
          ],
          "properties": {
            "schema_version": {}, "phase": { "const": "assess" },
            "result": { "enum": ["ready", "action-required", "blocked"] },
            "run_id": {}, "generated_at": {}, "machine": {}, "projects": {},
            "machine_summary": { "$ref": "#/$defs/machineSummary" },
            "default_selection": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/defaultSelection" }
            },
            "batch_summary": { "$ref": "#/$defs/batchSummary" },
            "assistant_selection": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/defaultSelection" }
            },
            "resolution_summary": { "$ref": "#/$defs/resolutionSummary" },
            "summary": {}, "next_actions": {}
          }
        }
      ]
    },
    "assistantPrepareReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "phase", "result", "run_id", "generated_at",
        "session_id", "expires_at", "selected_projects", "progress", "next_actions"
      ],
      "properties": {
        "schema_version": { "const": "2.0" },
        "phase": { "const": "assistant-prepare" },
        "result": { "const": "ready" },
        "run_id": { "$ref": "#/$defs/opaqueRunId" },
        "generated_at": { "type": "string", "format": "date-time" },
        "session_id": { "$ref": "#/$defs/opaqueSessionId" },
        "expires_at": { "type": "string", "format": "date-time" },
        "selected_projects": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "progress": { "$ref": "#/$defs/assistantProgress" },
        "next_actions": {
          "type": "array", "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assistantRunReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "phase", "result", "run_id", "generated_at",
        "session_id", "selected_projects", "progress", "detail", "next_actions"
      ],
      "properties": {
        "schema_version": { "const": "2.0" },
        "phase": { "const": "assistant-run" },
        "result": { "const": "ready" },
        "run_id": { "$ref": "#/$defs/opaqueRunId" },
        "generated_at": { "type": "string", "format": "date-time" },
        "session_id": { "$ref": "#/$defs/opaqueSessionId" },
        "selected_projects": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "progress": { "$ref": "#/$defs/assistantProgress" },
        "detail": { "type": "string", "minLength": 1 },
        "next_actions": {
          "type": "array", "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assistantStatusReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "phase", "result", "run_id", "generated_at",
        "session_id", "proposal_id", "selected_projects", "progress", "detail", "next_actions"
      ],
      "properties": {
        "schema_version": { "const": "2.0" },
        "phase": { "const": "assistant-status" },
        "result": { "enum": ["running", "ready", "blocked"] },
        "run_id": { "$ref": "#/$defs/opaqueRunId" },
        "generated_at": { "type": "string", "format": "date-time" },
        "session_id": { "$ref": "#/$defs/opaqueSessionId" },
        "proposal_id": {
          "oneOf": [
            { "$ref": "#/$defs/opaqueProposalId" },
            { "type": "null" }
          ]
        },
        "selected_projects": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "progress": { "$ref": "#/$defs/assistantProgress" },
        "detail": { "type": "string", "minLength": 1 },
        "next_actions": {
          "type": "array", "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "ready" } } },
          "then": { "properties": { "proposal_id": { "$ref": "#/$defs/opaqueProposalId" } } },
          "else": { "properties": { "proposal_id": { "type": "null" } } }
        }
      ]
    },
    "planReport": {
      "allOf": [
        { "$ref": "#/$defs/commonSuccess" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["request_fingerprint", "plan_id", "expires_at", "plans"],
          "properties": {
            "schema_version": {}, "phase": { "const": "plan" },
            "result": { "enum": ["ready", "action-required", "blocked"] },
            "run_id": {}, "generated_at": {}, "machine": {}, "projects": {},
            "summary": {}, "next_actions": {},
            "request_fingerprint": { "$ref": "#/$defs/fingerprint" },
            "plan_id": { "$ref": "#/$defs/opaquePlanId" },
            "expires_at": { "type": "string", "format": "date-time" },
            "plans": { "type": "array", "items": { "$ref": "#/$defs/projectPlan" } }
          }
        }
      ]
    },
    "applyReport": {
      "allOf": [
        { "$ref": "#/$defs/commonSuccess" },
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "request_fingerprint", "requested_plan_id", "plan_id", "ledger", "diagnostics"
          ],
          "properties": {
            "schema_version": {}, "phase": { "const": "apply" },
            "result": { "enum": ["applied", "partial", "blocked"] },
            "run_id": {}, "generated_at": {}, "machine": {}, "projects": {},
            "summary": {}, "next_actions": {},
            "request_fingerprint": { "$ref": "#/$defs/fingerprint" },
            "requested_plan_id": { "$ref": "#/$defs/opaquePlanId" },
            "plan_id": { "$ref": "#/$defs/opaquePlanId" },
            "ledger": { "type": "array", "items": { "$ref": "#/$defs/ledgerEntry" } },
            "diagnostics": { "$ref": "#/$defs/diagnostics" }
          }
        }
      ]
    },
    "recoveryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interrupted_run_id", "requested_plan_id", "outcome", "ledger", "diagnostics"
      ],
      "properties": {
        "interrupted_run_id": { "$ref": "#/$defs/opaqueRunId" },
        "requested_plan_id": { "$ref": "#/$defs/opaquePlanId" },
        "outcome": {
          "enum": ["applied", "rolled-back", "blocked", "incomplete-rollback"]
        },
        "ledger": {
          "type": "array",
          "items": { "$ref": "#/$defs/ledgerEntry" }
        },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      }
    },
    "recoverReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "phase", "result", "run_id", "generated_at",
        "recoveries", "next_actions"
      ],
      "properties": {
        "schema_version": { "const": "2.0" },
        "phase": { "const": "recover" },
        "result": { "enum": ["ready", "partial", "blocked"] },
        "run_id": { "$ref": "#/$defs/opaqueRunId" },
        "generated_at": { "type": "string", "format": "date-time" },
        "recoveries": {
          "type": "array",
          "items": { "$ref": "#/$defs/recoveryEntry" }
        },
        "next_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verifyReport": {
      "allOf": [
        { "$ref": "#/$defs/commonSuccess" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["request_fingerprint"],
          "properties": {
            "schema_version": {}, "phase": { "const": "verify" },
            "result": { "enum": ["ready", "action-required", "blocked"] },
            "run_id": {}, "generated_at": {}, "machine": {}, "projects": {},
            "summary": {}, "next_actions": {},
            "request_fingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        }
      ]
    },
    "errorReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "phase", "result", "exit_code", "error"],
      "properties": {
        "schema_version": { "const": "2.0" },
        "phase": { "const": "error" },
        "result": { "const": "error" },
        "exit_code": { "enum": [1, 2] },
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "detail"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "detail": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
