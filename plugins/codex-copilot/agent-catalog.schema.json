{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex-copilot/agent-catalog.schema.json",
  "title": "Codex Copilot Agent Catalog",
  "description": "Schema for the Codex-native source of truth for specialists, routing, and design chain.",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "entrypoints",
    "designChain",
    "agents",
    "optionalAgents",
    "routingEdges",
    "workflows",
    "execution"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_comment": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "entrypoints": {
      "type": "object",
      "required": [
        "primary",
        "launcher"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string"
        },
        "launcher": {
          "type": "string"
        }
      }
    },
    "designChain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Agent"
      }
    },
    "optionalAgents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/OptionalAgent"
      }
    },
    "routingEdges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RoutingEdge"
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "default",
        "backend",
        "policySkill",
        "deprecatedEntrypoints",
        "capacity",
        "writeOwnership",
        "convergence",
        "cleanup"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "const": "parallel-ready"
        },
        "backend": {
          "const": "tc cycle"
        },
        "policySkill": {
          "const": "parallel-execution"
        },
        "deprecatedEntrypoints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "orchestrate"
          ],
          "properties": {
            "orchestrate": {
              "const": "protocol"
            }
          }
        },
        "capacity": {
          "const": "native-and-resource-limits"
        },
        "writeOwnership": {
          "const": "exclusive"
        },
        "convergence": {
          "const": "single-owner"
        },
        "cleanup": {
          "const": "verified-merged-worktrees"
        }
      }
    }
  },
  "definitions": {
    "Agent": {
      "type": "object",
      "required": [
        "id",
        "skill",
        "role",
        "model",
        "methodology",
        "purpose"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "skill": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "default",
            "worker",
            "explorer"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "methodology": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "OptionalAgent": {
      "type": "object",
      "required": [
        "id",
        "pack",
        "skill",
        "role",
        "purpose"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "pack": {
          "type": "string"
        },
        "skill": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "optional",
            "setup-only"
          ]
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "RoutingEdge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "when"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "when": {
          "type": "string"
        }
      }
    }
  }
}
